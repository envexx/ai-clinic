// AI Clinic Front Desk — Prisma schema
// Source of truth for the domain database (Prisma Postgres / PostgreSQL).
// See PLAN.md (M0–M1) and PRD_MVP_AI_Clinic_Front_Desk.md section 14.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StaffRole {
  ADMIN
  RECEPTIONIST
}

model Clinic {
  id     String @id @default(uuid()) @db.Uuid
  name   String
  /// IANA timezone, e.g. "Asia/Dubai".
  timezone String @default("Asia/Dubai")
  currency String @default("AED")

  // Booking policy (PRD section 6). Durations are minutes.
  slotGranularityMinutes     Int @default(15)
  bookingHorizonDays         Int @default(30)
  minimumNoticeMinutes       Int @default(120)
  selfServiceCutoffMinutes   Int @default(120)
  pendingActionTtlMinutes    Int @default(5)

  version   Int      @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  staffUsers    StaffUser[]
  guestSessions GuestSession[]
  services      Service[]
  providers     Provider[]
  clinicHours   ClinicHour[]
  visitors      Visitor[]
  appointments  Appointment[]
  pendingActions PendingAction[]
  auditEvents   AuditEvent[]

  @@map("clinics")
}

model StaffUser {
  id           String    @id @default(uuid()) @db.Uuid
  clinicId     String    @db.Uuid
  email        String    @unique
  passwordHash String
  role         StaffRole @default(RECEPTIONIST)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @updatedAt @db.Timestamptz

  clinic   Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  sessions StaffSession[]

  @@index([clinicId, role, active])
  @@map("staff_users")
}

model StaffSession {
  id          String    @id @default(uuid()) @db.Uuid
  staffUserId String    @db.Uuid
  tokenHash   String    @unique
  expiresAt   DateTime  @db.Timestamptz
  revokedAt   DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz

  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("staff_sessions")
}

model GuestSession {
  id        String    @id @default(uuid()) @db.Uuid
  clinicId  String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz
  revokedAt DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz

  clinic   Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  visitors Visitor[]

  @@index([expiresAt])
  @@map("guest_sessions")
}

/// Clinic opening hours per weekday. Weekday uses ISO-8601: 1=Monday .. 7=Sunday.
/// Times are local wall-clock strings "HH:mm" in the clinic timezone.
model ClinicHour {
  id        String @id @default(uuid()) @db.Uuid
  clinicId  String @db.Uuid
  weekday   Int
  localStart String
  localEnd   String

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, weekday, localStart, localEnd])
  @@index([clinicId, weekday])
  @@map("clinic_hours")
}

model Service {
  id              String   @id @default(uuid()) @db.Uuid
  clinicId        String   @db.Uuid
  name            String
  durationMinutes Int
  bufferMinutes   Int      @default(0)
  /// Price in minor units (e.g. fils for AED). Integer only.
  priceMinor      Int
  active          Boolean  @default(true)
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @db.Timestamptz
  updatedAt       DateTime @updatedAt @db.Timestamptz

  clinic           Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  providerServices ProviderService[]
  appointments     Appointment[]

  @@unique([clinicId, name])
  @@index([clinicId, active])
  @@map("services")
}

model Provider {
  id          String   @id @default(uuid()) @db.Uuid
  clinicId    String   @db.Uuid
  displayName String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  clinic             Clinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  providerServices   ProviderService[]
  workingHours       WorkingHour[]
  scheduleExceptions ScheduleException[]
  appointments       Appointment[]

  @@unique([clinicId, displayName])
  @@index([clinicId, active])
  @@map("providers")
}

model ProviderService {
  providerId String @db.Uuid
  serviceId  String @db.Uuid

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([providerId, serviceId])
  @@index([serviceId])
  @@map("provider_services")
}

/// Recurring weekly working hours. Weekday uses ISO-8601: 1=Monday .. 7=Sunday.
/// Times are local wall-clock strings "HH:mm" in the clinic timezone.
model WorkingHour {
  id         String @id @default(uuid()) @db.Uuid
  providerId String @db.Uuid
  weekday    Int
  localStart String
  localEnd   String

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, weekday, localStart, localEnd])
  @@index([providerId, weekday])
  @@map("working_hours")
}

/// One-off time off. Stored as absolute instants; interval is [startsAt, endsAt).
model ScheduleException {
  id         String   @id @default(uuid()) @db.Uuid
  providerId String   @db.Uuid
  startsAt   DateTime @db.Timestamptz
  endsAt     DateTime @db.Timestamptz
  reason     String
  version    Int      @default(1)
  createdAt  DateTime @default(now()) @db.Timestamptz

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, startsAt, endsAt])
  @@map("schedule_exceptions")
}

enum AppointmentStatus {
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PendingActionType {
  CREATE_BOOKING
  RESCHEDULE_BOOKING
  CANCEL_BOOKING
}

enum PendingActionStatus {
  PENDING
  CONSUMED
  EXPIRED
  CANCELLED
}

/// Administrative contact for a booking, scoped to a guest session.
/// This is not a medical record.
model Visitor {
  id             String    @id @default(uuid()) @db.Uuid
  clinicId       String    @db.Uuid
  guestSessionId String    @db.Uuid
  displayName    String
  contact        String
  consentAt      DateTime? @db.Timestamptz
  createdAt      DateTime  @default(now()) @db.Timestamptz

  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  guestSession GuestSession  @relation(fields: [guestSessionId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([guestSessionId])
  @@map("visitors")
}

/// Appointment with snapshotted service details so history stays correct even
/// if the service later changes. The interval [startAt, occupiedEnd) is the
/// provider's occupied range (service duration plus buffer).
model Appointment {
  id            String            @id @default(uuid()) @db.Uuid
  clinicId      String            @db.Uuid
  visitorId     String            @db.Uuid
  serviceId     String            @db.Uuid
  providerId    String            @db.Uuid
  bookingReference String         @unique

  // Snapshots
  serviceName     String
  durationMinutes Int
  bufferMinutes   Int
  priceMinor      Int
  currency        String

  startAt     DateTime @db.Timestamptz
  endAt       DateTime @db.Timestamptz
  occupiedEnd DateTime @db.Timestamptz
  status      AppointmentStatus @default(CONFIRMED)
  version     Int      @default(1)

  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz
  cancelledAt DateTime? @db.Timestamptz
  checkedInAt DateTime? @db.Timestamptz
  completedAt DateTime? @db.Timestamptz
  noShowAt    DateTime? @db.Timestamptz

  clinic   Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  visitor  Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id])
  provider Provider @relation(fields: [providerId], references: [id])

  @@index([providerId, startAt, occupiedEnd])
  @@index([clinicId, status, startAt])
  @@index([visitorId])
  @@map("appointments")
}

/// A versioned, single-use confirmation request. The model may create it; only
/// the owning session can consume it (PRD section 15).
model PendingAction {
  id             String              @id @default(uuid()) @db.Uuid
  clinicId       String              @db.Uuid
  type           PendingActionType
  guestSessionId String              @db.Uuid
  payload        Json
  payloadHash    String
  status         PendingActionStatus @default(PENDING)
  expiresAt      DateTime            @db.Timestamptz
  consumedAt     DateTime?           @db.Timestamptz
  createdAt      DateTime            @default(now()) @db.Timestamptz

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([guestSessionId, status])
  @@index([expiresAt])
  @@map("pending_actions")
}

model IdempotencyRecord {
  id          String   @id @default(uuid()) @db.Uuid
  scope       String
  key         String
  requestHash String
  status      String
  result      Json?
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  @@unique([scope, key])
  @@map("idempotency_records")
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  clinicId   String   @db.Uuid
  actorType  String
  actorId    String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  requestId  String?
  createdAt  DateTime @default(now()) @db.Timestamptz

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId, createdAt])
  @@index([clinicId, action, createdAt])
  @@map("audit_events")
}
